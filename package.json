{
  "name": "igni-sdk",
  "private": true,
  "description": "The npm half of igni's SDKs: the extension bridge, the React floor and the stylesheet, tested and type-checked together. Each is published on its own (docs/PUBLISHING_THE_SDKS.md).",
  "type": "module",
  "workspaces": [
    "packages/extension-bridge",
    "packages/ui-react",
    "packages/test-utils",
    "clients/ui"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "mermaid": "^11.17.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  }
}
