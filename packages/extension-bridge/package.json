{
  "name": "@ignite-ember/extension-bridge",
  "version": "0.2.0",
  "description": "The guest half of the bridge between an igni extension's page and igni: connect(), RPC, navigation, theme. The host imports the same protocol, so there is one description of the wire.",
  "keywords": [
    "igni",
    "extension",
    "bridge",
    "iframe",
    "postmessage"
  ],
  "license": "Apache-2.0",
  "author": "Ignite Ember (https://ignite-ember.sh/)",
  "homepage": "https://ignite-ember.sh/docs/sdk/extension-bridge",
  "documentation": "https://ignite-ember.sh/docs/sdk/extension-bridge",
  "bugs": {
    "url": "https://github.com/ignite-ember/igni-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ignite-ember/igni-sdk.git",
    "directory": "packages/extension-bridge"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "node": "./dist/protocol.js",
      "default": "./src/protocol.ts"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "node": "./dist/tokens.js",
      "default": "./src/tokens.ts"
    }
  },
  "files": [
    "src",
    "dist",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
